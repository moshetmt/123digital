# Copier dans .env.local (dev) et dans les variables d'environnement Vercel (prod)

# Webhook Google Apps Script qui écrit dans le Sheet « 123digital - LEADS »
# (code : _scripts/leads-webhook.gs — URL de déploiement en .../exec)
SHEETS_WEBHOOK_URL=

# Secret partagé avec la propriété de script SHARED_SECRET du même projet Apps
# Script. Sans lui, n'importe qui connaissant l'URL pourrait remplir le Sheet.
SHEETS_WEBHOOK_SECRET=

# Clé API Resend (https://resend.com) — sans elle, pas de notification email
RESEND_API_KEY=

# Destinataire des demandes d'audit (défaut : mochetimsit@gmail.com)
CONTACT_TO=
